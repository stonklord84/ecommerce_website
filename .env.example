# Copy this file to .env and fill in the values from
# Supabase dashboard → Project Settings → API.
SUPABASE_URL=https://your-project-ref.supabase.co
# The anon / publishable key. Never put the service_role / secret key here.
SUPABASE_KEY=
# Shared password for the Supabase Database Webhooks that call /api/revalidate.
# Must match the x-revalidate-secret header set on each webhook.
REVALIDATE_SECRET=
# Stripe dashboard → Developers → API keys. Use the sk_test_ key until going live.
STRIPE_SECRET_KEY=
